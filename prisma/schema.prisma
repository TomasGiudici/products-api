generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["catalog"]
}

model brand {
  id              Int       @id @default(autoincrement())
  name            String    @unique @db.VarChar(100)
  normalized_name String    @unique @db.VarChar(100)
  products        product[]

  @@map("brands")
  @@schema("catalog")
}

model category {
  id              Int       @id @default(autoincrement())
  name            String    @unique @db.VarChar(100)
  normalized_name String    @unique @db.VarChar(100)
  products        product[]

  @@map("categories")
  @@schema("catalog")
}

model product {
  ean            String           @id @unique @db.VarChar(13)
  name           String           @db.VarChar(255)
  brand_id       Int
  category_id    Int
  quantity       Decimal?         @db.Decimal(10, 2)
  unit_id        Int?
  units_per_pack Int?
  image_path     String?
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)

  brand           brand            @relation(fields: [brand_id], references: [id], onUpdate: NoAction, map: "fk_products_brand")
  category        category         @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "fk_products_category")
  unit_of_measure unit_of_measure? @relation(fields: [unit_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_products_unit")

  @@index([brand_id], map: "idx_products_brand_id")
  @@index([category_id], map: "idx_products_category_id")
  @@map("products")
  @@schema("catalog")
}

model unit_of_measure {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(50)
  abbreviation String    @unique @db.VarChar(10)
  products     product[]

  @@map("units_of_measure")
  @@schema("catalog")
}